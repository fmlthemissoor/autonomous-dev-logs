# --- LLM provider ---
# "subscription" uses the `claude` CLI from Claude Code (counts against your Max subscription).
# "api" uses the Anthropic API (pay per token, supports prompt caching).
LLM_PROVIDER=subscription

# Required only when LLM_PROVIDER=api
ANTHROPIC_API_KEY=
# Model to use when calling the API directly.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Path to the `claude` CLI (only used when LLM_PROVIDER=subscription).
# Leave blank to rely on $PATH.
CLAUDE_CLI_PATH=

# --- Telegram ---
# Create a bot via @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=
# Send any message to your bot, then visit
# https://api.telegram.org/bot<token>/getUpdates to find your chat id.
TELEGRAM_CHAT_ID=

# --- Image generation (optional, for the `illustration` visual format) ---
# Leave blank to disable illustration generation. Charts and code snippets work without this.
OPENAI_API_KEY=

# --- Voice learning (optional but highly recommended) ---
# Required when voice_learning.enabled=true in config.yaml.
# SocialData.tools is used to read public tweet metadata (likes/RTs/replies/views)
# from your account and any inspiration accounts you list. Sign up at
# https://socialdata.tools and paste your key here. Keep it secret — it's
# tied to your billing.
SOCIALDATA_API_KEY=

# --- Behavior ---
# How many hours of transcripts to summarize. Default: 24.
LOOKBACK_HOURS=24
# Where to read Claude Code session transcripts from.
CLAUDE_PROJECTS_DIR=~/.claude/projects
